# PostgreSQL connection for the auth-service (self-contained database)
AUTH_DATABASE_URL="postgresql://propify:propify_password@localhost:5432/propify_auth?schema=public"

# JWT signing secret (rotate in production)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# Used to hash refresh tokens (pepper; keep secret)
JWT_REFRESH_SECRET="change-me-refresh-secret"
REFRESH_TOKEN_TTL_DAYS="7"

# Access token TTL in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS="900"

# Public base URLs used to build verification / reset links
FRONTEND_URL="http://localhost:3001"
AUTH_SERVICE_PORT="3002"
